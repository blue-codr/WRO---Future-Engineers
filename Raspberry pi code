

import cv2
import serial
import time

# Serial connection from Raspberry Pi -> ESP32
# Change /dev/ttyUSB0 to the port your ESP32 uses
esp32 = serial.Serial('/dev/ttyUSB0', 115200, timeout=1)
time.sleep(2)

# Camera
cap = cv2.VideoCapture(0)

# HSV ranges
# Red: hue wraps around, so we need two ranges
RED_LOWER1 = (0, 100, 100)
RED_UPPER1 = (10, 255, 255)

RED_LOWER2 = (170, 100, 100)
RED_UPPER2 = (180, 255, 255)

# Green
GREEN_LOWER = (40, 100, 100)
GREEN_UPPER = (80, 255, 255)

last_command = None

while True:
    ret, frame = cap.read()

    if not ret:
        print("Camera error")
        break

    # Convert BGR -> HSV
    hsv = cv2.cvtColor(frame, cv2.COLOR_BGR2HSV)

    # Create masks
    red_mask1 = cv2.inRange(hsv, RED_LOWER1, RED_UPPER1)
    red_mask2 = cv2.inRange(hsv, RED_LOWER2, RED_UPPER2)
    red_mask = cv2.bitwise_or(red_mask1, red_mask2)

    green_mask = cv2.inRange(
        hsv,
        GREEN_LOWER,
        GREEN_UPPER
    )

    # Find contours
    red_contours, _ = cv2.findContours(
        red_mask,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    green_contours, _ = cv2.findContours(
        green_mask,
        cv2.RETR_EXTERNAL,
        cv2.CHAIN_APPROX_SIMPLE
    )

    red_area = 0
    green_area = 0

    # Largest red object
    if red_contours:
        red_area = max(cv2.contourArea(c) for c in red_contours)

    # Largest green object
    if green_contours:
        green_area = max(cv2.contourArea(c) for c in green_contours)

    # Minimum area prevents tiny noise from triggering the robot
    MIN_AREA = 500

    command = None

    if red_area > MIN_AREA:
        command = "dodgeright()"

    elif green_area > MIN_AREA:
        command = "dodgeleft()"

    # Only send when the detected command changes
    if command is not None and command != last_command:
        esp32.write((command + "\n").encode())
        print("Sent:", command)
        last_command = command

    elif command is None:
        last_command = None

    # Display camera
    cv2.imshow("Camera", frame)
    cv2.imshow("Red", red_mask)
    cv2.imshow("Green", green_mask)

    # Press Q to quit
    if cv2.waitKey(1) & 0xFF == ord('q'):
        break

cap.release()
esp32.close()
cv2.destroyAllWindows()
